<?xml version="1.0"?>
<ruleset name="Restwell Retreats">
	<description>WordPress Coding Standards for the Restwell theme (restwell-theme/).</description>

	<file>restwell-theme</file>
	<!-- Public enquire/mail/CRM side-effects live in the mu-plugin; lint them with the theme. -->
	<file>wp-content/mu-plugins/restwell-crm</file>
	<file>wp-content/mu-plugins/restwell-crm.php</file>

	<arg name="extensions" value="php"/>
	<arg value="psn"/>
	<arg name="colors"/>

	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="7.4-"/>
	<config name="text_domain" value="restwell-retreats"/>
	<config name="prefix" value="restwell"/>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>restwell-theme/tests/*</exclude-pattern>
	<exclude-pattern>restwell-theme/inc/theme-setup/migrations-archive-v1-v28.php</exclude-pattern>
	<exclude-pattern>restwell-theme/inc/theme-setup/migrations-archive-v29-v31.php</exclude-pattern>
	<exclude-pattern>restwell-theme/docs/archive/tailwind-source/tailwind.css</exclude-pattern>
	<exclude-pattern>*/package-lock.json</exclude-pattern>

	<!-- Extra includes Core (tabs). phpcbf applies that indent. Yoda is excluded:
	     293 flips of readable `===` order, not a security sniff. -->
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.PHP.YodaConditions"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Walker lives in nav.php; CRM gateway class lives in services/bootstrap.php. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/inc/nav.php</exclude-pattern>
		<exclude-pattern>*/inc/services/bootstrap.php</exclude-pattern>
	</rule>
	<rule ref="Universal.Files.SeparateFunctionsFromOO.Mixed">
		<exclude-pattern>*/inc/nav.php</exclude-pattern>
		<exclude-pattern>*/inc/services/bootstrap.php</exclude-pattern>
	</rule>

	<!-- Thin wrapper around wp_get_attachment_image(), which WPCS already trusts as pre-escaped. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customAutoEscapedFunctions" type="array">
				<element value="restwell_get_property_attachment_image"/>
			</property>
		</properties>
	</rule>
</ruleset>
