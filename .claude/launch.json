{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "restwell-mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4400",
        "--directory",
        "restwell-theme"
      ],
      "port": 4400
    },
    {
      "name": "restwell-playground",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "@wp-playground/cli@latest",
        "server",
        "--port=9410",
        "--site-url=http://localhost:9410",
        "--mount-before-install=./restwell-theme:/wordpress/wp-content/themes/restwell-theme",
        "--mount-before-install=./.claude/playground-local:/wordpress/wp-content/playground-local",
        "--blueprint=./.claude/playground-blueprint.json"
      ],
      "port": 9410
    }
  ]
}
